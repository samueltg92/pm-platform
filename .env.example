# Copia a .env.local para desarrollo. En Easypanel, cárgalas como variables de entorno.

# Postgres. En Easypanel usa el host interno del servicio, no localhost.
DATABASE_URL=postgres://usuario:clave@localhost:5432/pm_platform
# true solo si tu Postgres exige TLS (gestionados). En Easypanel interno, déjalo vacío.
DATABASE_SSL=

# Firma de la cookie de sesión. Mínimo 32 caracteres.
# Genera uno con: openssl rand -base64 48
SESSION_SECRET=

# Usuario inicial, lo lee `npm run db:seed`.
PM_EMAIL=
PM_PASSWORD=
PM_NOMBRE=

# Zona horaria para fechas y recordatorios.
TZ_APP=America/Bogota

# --- IA: traducción al inglés y, más adelante, ingesta de transcripts ---
# Basta con una de las dos. Si están ambas, gana Gemini.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Opcionales. Por defecto: gemini-3.6-flash y claude-opus-5.
# Google retira modelos periódicamente; si ves un 404 en los logs, aquí se
# corrige sin tocar código.
GEMINI_MODELO=
ANTHROPIC_MODELO=

# --- Slack ---
# Sin estas tres, la app funciona igual pero no manda ni recibe nada.
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=
SLACK_CANAL=C01234567

# URL pública, para los enlaces de los mensajes de Slack.
APP_URL=https://n8n-pm-app.hr3und.easypanel.host

# Correo saliente (Resend). Sin esto, "Olvidé mi contraseña" no puede enviar
# nada y la pantalla lo dice en vez de prometer un correo que no llegará.
# El remitente debe estar en un dominio verificado en Resend.
RESEND_API_KEY=
CORREO_DESDE=PM Platform <no-responder@tu-dominio.com>
